<?xml version="1.0" encoding="UTF-8"?>
<!--
  Stub .m2/settings.xml for the sbtResolvers-m2-settings-override probe.

  PURPOSE: This file exists so the QA harness can copy it to ~/.m2/settings.xml
  before running the Mend Unified Agent. It simulates the environment where
  SBT 2.0.11 fixed the bug — the <mirror> stanza here used to cause UA to
  override the sbtResolvers declared in build.sbt, routing ALL artifact
  resolution through the mirror URL instead of honouring the build's resolver
  list.

  EXPECTED BEHAVIOUR (post-fix, sbt >= 2.0.11):
    sbt resolvers in build.sbt take precedence; this mirror does NOT override
    them. UA should detect:
      - slf4j-api and logback-* from "Maven Central Explicit"
      - commons-codec from "Custom Releases" (private-index)

  BUG BEHAVIOUR (pre-fix, sbt < 2.0.11):
    This mirror entry would replace both resolvers, routing everything through
    https://repo.example.com/maven2/ and potentially breaking resolution of
    slf4j-api / logback-* (not present there), causing UA to miss those deps.

  Do NOT copy this file manually — the QA harness manages placement.
-->
<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0
                              https://maven.apache.org/xsd/settings-1.0.0.xsd">
  <mirrors>
    <mirror>
      <id>example-mirror</id>
      <name>Example Corporate Mirror</name>
      <!-- This URL intentionally differs from build.sbt resolvers to
           reproduce the override scenario. -->
      <url>https://repo.example.com/maven2/</url>
      <mirrorOf>*</mirrorOf>
    </mirror>
  </mirrors>
</settings>
